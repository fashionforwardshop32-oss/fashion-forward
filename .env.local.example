# Copy to .env.local (used by `npm run dev` and inlined into the bundle at
# `npm run cf:deploy` build time) and to .dev.vars (used by the local Workers
# runtime in `npm run cf:preview`). Both files are gitignored.
#
# Values come from the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never commit.
# For the deployed Worker set it with: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of admin login emails (owner/staff).
ADMIN_EMAILS=

# Customer support / out-of-zone contact link, shown when an address falls
# outside the Bangalore delivery area. E.164 format, digits only after the +
# (e.g. 919999999999), used to build a https://wa.me/ link.
NEXT_PUBLIC_WHATSAPP_CONTACT_NUMBER=
